<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- مجوزهای لازم برای برنامه -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_touch_loop_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_touch_loop_logo"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        tools:targetApi="31">

        <!-- اکتیویتی اصلی برنامه -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- سرویس دسترسی برای ضبط و اجرای ماکرو -->
        <service
            android:name=".MacroAccessibilityService"
            android:exported="true"
            android:label="Touch Loop Macro Service"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:summary="ضبط و پخش خودکار حرکات لمسی برای انجام کارهای تکراری">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>
</manifest>
